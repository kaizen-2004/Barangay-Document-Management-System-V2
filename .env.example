# Copy this file to .env and set real values.
APP_ENV=production
SECRET_KEY=change-me
DATABASE_URL=mysql+pymysql://barangay_user:barangay_password@127.0.0.1:3306/barangay_db?charset=utf8mb4
HOST=0.0.0.0
PORT=8000
APP_DATA_DIR=C:\barangay_system\data
UPLOAD_DIR=C:\barangay_system\data\uploads
DOCUMENT_OUTPUT_DIR=C:\barangay_system\data\documents
TEMPLATE_DIR=C:\barangay_system\data\templates
BACKUP_DIR=C:\barangay_system\data\backups
MYSQLDUMP_BIN=mysqldump
MYSQL_BIN=mysql
SESSION_COOKIE_SECURE=False
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
REMEMBER_ME_SECONDS=604800
