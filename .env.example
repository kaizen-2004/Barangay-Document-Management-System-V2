# Copy this file to .env and set local values.
APP_ENV=production
SECRET_KEY=change-me
# SQLite is the supported barangay-office deployment database.
# Leave this commented to use the default ./data/barangay.db location.
# For a fixed Windows location, use a full path, for example:
# DATABASE_URL=sqlite:///C:/barangay_system/app/data/barangay.db
HOST=0.0.0.0
PORT=5000
UPLOAD_FOLDER=./data/uploads
DOCUMENT_STORAGE_ROOT=./data
DOCX_TEMPLATE_UPLOAD_DIR=./data/templates
DOCX_OUTPUT_DIR=./data/documents
BACKUP_DIR=./data/backups
SESSION_COOKIE_SECURE=False
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
REMEMBER_ME_SECONDS=604800

# Background removal API (optional)
# Get your free key at https://www.remove.bg/api (50 free calls/month)
# When set, uses the API when online, falls back to local rembg when offline.
# REMOVE_BG_API_KEY=your-api-key-here

# Password reset email (Brevo/Sendinblue)
# Get your free API key at https://app.brevo.com/settings/api-keys (300 emails/day free)
# BREVO_API_KEY=your_api_key_here
# BREVO_FROM_EMAIL=your@email.com
# BREVO_FROM_NAME=Barangay System

# Branding — override defaults from config.py
# SYSTEM_NAME=Barangay Management System
# BARANGAY_NAME=RENZPONSABLENG BARANGAY
# SYSTEM_DESCRIPTION=Barangay Document Management and Archiving System
# APP_VERSION=0.1.0
# APP_AUTHOR=Steve Villa

# Public URL for QR codes — when set, QR codes on printed documents
# link to this URL instead of the local server. This makes QR codes
# work from any network, even after printing.
#
# Option A: Google Drive (easiest, free, always accessible)
#   1. Run: python scripts/generate_verification_image.py
#   2. Upload the generated image to Google Drive
#   3. Right-click → Share → "Anyone with the link"
#   4. Copy the file ID from the URL:
#        https://drive.google.com/file/d/YOUR_FILE_ID/view
#   5. Set below:
#        PUBLIC_URL=https://drive.usercontent.google.com/download?id=YOUR_FILE_ID&export=view
#
# Option B: Cloudflare Tunnel (dynamic, your own server)
#   1. Run: start-tunnel.bat
#   2. Copy the URL it gives you
#   3. Set below:
#        PUBLIC_URL=https://abc-123.trycloudflare.com
#
# PUBLIC_URL=
