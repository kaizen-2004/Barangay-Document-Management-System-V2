# Copy this file to .env and set real values.
APP_ENV=production
SECRET_KEY=change-me
# DATABASE_URL defaults to an SQLite database at ./data/barangay.db
# (resolved to an absolute path automatically).  Uncomment below to
# use a custom location or a different database backend.
# DATABASE_URL=sqlite:///C:/path/to/barangay.db
HOST=0.0.0.0
PORT=5000
APP_DATA_DIR=./data
UPLOAD_DIR=./data/uploads
DOCUMENT_OUTPUT_DIR=./data/documents
TEMPLATE_DIR=./data/templates
BACKUP_DIR=./data/backups
SESSION_COOKIE_SECURE=False
SESSION_IDLE_TIMEOUT_SECONDS=3600
SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
REMEMBER_ME_SECONDS=604800

# Branding — override defaults from config.py
# SYSTEM_NAME=Barangay Management System
# BARANGAY_NAME=RENZPONSABLENG BARANGAY
# SYSTEM_DESCRIPTION=Barangay Document Management and Archiving System
# APP_VERSION=0.1.0
# APP_AUTHOR=Steve Villa
